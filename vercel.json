{
  "rewrites": [
    {
      "source": "/admin/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
